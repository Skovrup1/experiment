Vec2 :: struct {
    x: S32,
    y: S32,
}

make_vec2 :: (x: S32, y: S32) -> Vec2 {
    return {1, 2};
}

main :: () -> S32 {
    a := Vec2{1, 2};
    return a.x;
}

